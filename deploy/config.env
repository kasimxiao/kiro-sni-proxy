#############################################
# Kiro SNI Proxy 自动化部署配置
# 用法：编辑本文件后执行 ./deploy.sh
#############################################

# ===== AWS 基础配置 =====
export AWS_REGION="us-east-1"            # 部署 Region（Kiro 后端所在区域）
export PROJECT_NAME="kiro-sni-proxy"      # 资源命名前缀 / 标签

# ===== 网络：二选一 =====
# 模式 A：复用已有 VPC/子网 —— 同时填写下面两项
#   子网必须是【公网子网】（常规场景需要 EIP 出网），且能被赋公网 IP
export EXISTING_VPC_ID=""                 # 例：vpc-0123456789abcdef0（留空则新建 VPC）
export EXISTING_SUBNET_ID=""              # 例：subnet-0123456789abcdef0（公网子网）

# 模式 B：新建 VPC/子网 —— 上面两项留空时生效，使用下面的网段
export NEW_VPC_CIDR="10.199.0.0/16"
export NEW_SUBNET_CIDR="10.199.1.0/24"
export NEW_SUBNET_AZ=""                   # 留空则自动选择该 Region 第一个可用区

# ===== EC2 配置 =====
export INSTANCE_TYPE="c6g.large"          # arm64 Graviton；如需 x86 改为 c6i.large 并调整 AMI 架构
export INSTANCE_ARCH="arm64"              # arm64 | x86_64（需与 INSTANCE_TYPE 匹配）
export EBS_SIZE_GB="20"
# ===== 多网卡（可选）=====
# 实例挂载的 ENI 数量（含主网卡）。1 = 单网卡（默认，行为与原版完全一致）
# >1 时：额外 ENI 建在同一子网、共用代理安全组，每块 ENI 各绑定一个独立 EIP。
# nginx listen 443 监听所有网卡，客户端 hosts 指向哪个 EIP/私有 IP，流量就从对应网卡进入。
# 注意：多网卡不增加带宽（带宽取决于实例规格）；实例类型必须支持该 ENI 数量
#       （c6g.large 最多 3 块，c6g.xlarge 最多 4 块）。
export ENI_COUNT="1"
export KEY_NAME=""                        # 可选：EC2 密钥对名（留空则仅用 SSM 登录，推荐留空）

# ===== 安全组：管理入站来源 =====
# 22 端口（SSH）仅放行以下 CIDR；留空则完全不开 22（推荐，用 SSM 登录）
export ADMIN_SSH_CIDR=""                  # 例：203.0.113.10/32
# 443 入站放行范围。常规场景客户端走公网连 EIP，需放行 0.0.0.0/0
export INGRESS_443_CIDR="0.0.0.0/0"

# ===== PrivateLink（VPCE）开关 =====
# true  = 创建 q + codewhisperer 两个接口终端节点（走 AWS 骨干网，合规性更好，+约$15/月）
# false = 不创建 VPCE，nginx 零改动，DNS 回落公网解析（省钱，流量绕公网）
export ENABLE_PRIVATELINK="true"

# ===== nginx SNI 白名单域名 =====
# 默认包含 Kiro 运行时 5 个域名。如需“完全隔离场景”的认证域名，追加到此处。
# 每行格式："<域名>"，脚本会生成 map 转发规则。
export SNI_DOMAINS=(
  "codewhisperer.${AWS_REGION}.amazonaws.com"
  "q.${AWS_REGION}.amazonaws.com"
  "cli.kiro.dev"
  "runtime.${AWS_REGION}.kiro.dev"
  "management.${AWS_REGION}.kiro.dev"
)
